---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects — Nate Loum">
  <h1>Projects</h1>
  <p class="intro">
    A selection of tools and libraries I've built. See <a href="https://github.com/nloum"
      >github.com/nloum</a
    > for everything else.
  </p>
  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</BaseLayout>

<style>
  .intro {
    color: var(--muted);
    max-width: 60ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
