---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // Drafts are visible in dev so they can be previewed while being written,
  // but are excluded from production builds.
  const studies = await getCollection(
    'caseStudies',
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${study.data.title} — Nate Loum`} description={study.data.description}>
  <article>
    <header class="post-header">
      <p class="kicker">Case study · {study.data.project}</p>
      <h1>{study.data.title}</h1>
      <p class="meta">
        <time datetime={study.data.pubDate.toISOString()}>{formatDate(study.data.pubDate)}</time>
        {
          study.data.updatedDate && (
            <span> · Updated {formatDate(study.data.updatedDate)}</span>
          )
        }
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .kicker {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-header h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    border: 1px solid var(--border);
  }

  .prose :global(code) {
    font-size: 0.9em;
  }

  .prose :global(img) {
    max-width: 100%;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1.5rem 0;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--card-bg);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
</style>
