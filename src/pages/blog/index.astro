---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog — Nate Loum" description="Writing by Nate Loum on developer tools, infrastructure, and software engineering.">
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p class="empty">Nothing published yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-link" href={`/blog/${post.id}`}>
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </a>
            <p class="post-description">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .empty {
    color: var(--muted);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg);
  }

  .post-title {
    font-weight: 600;
    font-size: 1.15rem;
  }

  .post-link time {
    color: var(--muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .post-description {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }
</style>
