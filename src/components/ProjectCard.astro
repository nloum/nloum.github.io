---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Tag = project.url ? 'a' : 'div';
const linkProps = project.url
  ? { href: project.url, target: '_blank', rel: 'noopener noreferrer' }
  : {};

const aiLabel: Record<Project['aiAssistance'], string> = {
  none: 'No AI assistance',
  low: 'Low AI assistance',
  medium: 'Medium AI assistance',
  high: 'High AI assistance',
};
---

<Tag class="card" class:list={{ 'card-static': !project.url }} {...linkProps}>
  <div class="card-head">
    <h3>{project.name}</h3>
    <span class="lang">{project.language}</span>
  </div>
  <p class="tagline">{project.tagline}</p>
  <p class="description">{project.description}</p>
  <div class="tags">
    {project.private && <span class="tag private">Private repo</span>}
    <span class={`tag ai ai-${project.aiAssistance}`}>{aiLabel[project.aiAssistance]}</span>
    {project.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    color: var(--fg);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .card:not(.card-static):hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card-static {
    cursor: default;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .lang {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .tagline {
    margin: 0.35rem 0 0;
    font-weight: 500;
  }

  .description {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.925rem;
  }

  .tags {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .tag.private {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tag.ai-none {
    opacity: 0.7;
  }

  .tag.ai-low {
    color: #4a8f3c;
    border-color: #4a8f3c;
  }

  .tag.ai-medium {
    color: #b8860b;
    border-color: #b8860b;
  }

  .tag.ai-high {
    color: #c14444;
    border-color: #c14444;
  }
</style>
