---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
// Cards with a case study become plain containers with explicit links inside,
// since an <a> can't nest another <a>.
const Tag = project.url && !project.caseStudy ? 'a' : 'div';
const linkProps =
  Tag === 'a' ? { href: project.url, target: '_blank', rel: 'noopener noreferrer' } : {};

const aiLabel: Record<Project['aiAssistance'], string> = {
  none: 'No AI assistance',
  low: 'Low AI assistance',
  medium: 'Medium AI assistance',
  high: 'High AI assistance',
};
---

<Tag class="card" class:list={{ 'card-static': !project.url }} {...linkProps}>
  <div class="card-head">
    <h3>{project.name}</h3>
    <span class="lang">{project.language}</span>
  </div>
  <p class="tagline">{project.tagline}</p>
  <p class="description">{project.description}</p>
  {
    project.caseStudy && (
      <p class="links">
        <a href={project.caseStudy}>Case study →</a>
        {project.url && (
          <a href={project.url} target="_blank" rel="noopener noreferrer">
            {new URL(project.url).host} ↗
          </a>
        )}
      </p>
    )
  }
  <div class="tags">
    {project.private && <span class="tag private">Private repo</span>}
    <span class="tag ai">{aiLabel[project.aiAssistance]}</span>
    {project.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    color: var(--fg);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .card:not(.card-static):hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card-static {
    cursor: default;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .lang {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .tagline {
    margin: 0.35rem 0 0;
    font-weight: 500;
  }

  .description {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.925rem;
  }

  .links {
    margin: 0.6rem 0 0;
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .tags {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }

  .tag.private {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tag.ai {
    border-style: dashed;
  }
</style>
